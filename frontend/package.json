{
  "name": "entrolix-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "start:api": "node --env-file-if-exists=.env.local server/start.mjs",
    "verify:enquiry": "node --test scripts/verify-enquiry.mjs",
    "build": "vite build --configLoader runner && node scripts/prerender.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:motion": "node scripts/verify-motion.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:expertise": "node scripts/verify-expertise.mjs",
    "verify:why": "node scripts/verify-why.mjs",
    "verify:process": "node scripts/verify-process.mjs",
    "verify:directory": "node scripts/verify-directory.mjs",
    "verify:internal": "node scripts/verify-internal.mjs",
    "check": "npm run verify:enquiry && npm run verify:pages && npm run verify:motion && npm run build && npm run verify:build && npm run verify:expertise && npm run verify:why && npm run verify:process && npm run verify:directory && npm run verify:internal",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
